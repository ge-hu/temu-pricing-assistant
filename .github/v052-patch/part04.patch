 *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:"Microsoft YaHei",Segoe UI,sans-serif;background:var(--bg,#f4f6f9);color:var(--text,#0f172a)}.page{padding:18px;max-width:900px;margin:auto}.head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.head h1{font-size:19px;margin:0}.badge{font-size:11px;color:var(--blue,#2563eb);background:color-mix(in srgb,var(--blue) 9%,var(--surface,#fff));border:1px solid color-mix(in srgb,var(--blue) 25%,var(--surface,#fff));padding:4px 8px;border-radius:999px}.card{background:color-mix(in srgb,var(--surface,#fff) 96%,transparent);border:1px solid var(--line,#dbe4ef);border-radius:13px;margin-bottom:11px;padding:13px 14px;box-shadow:0 4px 14px rgba(15,23,42,.04)}.card h2{font-size:13px;margin:0 0 10px;display:flex;align-items:center;gap:7px}.row{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-top:1px solid color-mix(in srgb,var(--line) 65%,transparent)}.row:first-of-type{border-top:0}.row label,.label{font-size:12px;font-weight:700}.sub{font-size:10px;color:var(--muted,#64748b);margin-top:2px;line-height:1.45}.switch{width:42px;height:24px;position:relative;flex:none}.switch input{display:none}.switch span{position:absolute;inset:0;background:#cbd5e1;border-radius:999px;cursor:pointer}.switch span:after{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.18s}.switch input:checked+span{background:var(--blue,#2563eb)}.switch input:checked+span:after{transform:translateX(18px)}input[type=number],select{width:110px;height:31px;border:1px solid var(--line,#cbd5e1);border-radius:7px;padding:0 8px;background:var(--surface,#fff);color:var(--text)}input[type=range]{width:150px;accent-color:var(--blue)}.btns{display:flex;gap:7px;flex-wrap:wrap}.btn{height:34px;border:1px solid var(--line,#cbd5e1);border-radius:8px;background:var(--surface,#fff);color:var(--text,#334155);font-size:11px;font-weight:700;padding:0 10px;cursor:pointer}.btn.primary{background:var(--blue,#2563eb);border-color:var(--blue,#2563eb);color:#fff}.btn:hover{border-color:var(--blue)}.note{font-size:10px;color:var(--muted);line-height:1.55}.status{font-size:11px;color:#16a34a;min-height:16px;margin-top:8px}.colors{display:grid;grid-template-columns:repeat(5,minmax(95px,1fr));gap:8px;margin:8px 0 12px}.color-item{padding:8px;border:1px solid var(--line);border-radius:9px;background:color-mix(in srgb,var(--surface) 94%,transparent)}.color-item span{display:block;font-size:10px;color:var(--muted);margin-bottom:5px}.color-item input{width:100%;height:34px;border:0;background:transparent;padding:0;cursor:pointer}.presets{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:9px}.preview{height:82px;border-radius:11px;border:1px solid var(--line);padding:10px;position:relative;overflow:hidden;background:var(--bg)}.preview:before{content:"";position:absolute;inset:0;background-image:var(--desktop-wallpaper);background-size:cover;background-position:center;opacity:var(--desktop-wallpaper-opacity)}.preview-card{position:relative;width:62%;height:56px;border-radius:9px;background:color-mix(in srgb,var(--surface) 94%,transparent);border:1px solid var(--line);padding:8px}.preview-title{height:8px;width:46%;border-radius:4px;background:var(--blue)}.preview-line{height:6px;width:76%;margin-top:8px;border-radius:4px;background:color-mix(in srgb,var(--text) 18%,transparent)}.asset-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:8px 0}.asset-preview{width:48px;height:48px;border-radius:12px;border:1px solid var(--line);object-fit:cover;background:var(--surface)}.shortcut-list{display:flex;flex-direction:column}.shortcut-row{display:grid;grid-template-columns:minmax(150px,1fr) 48px 220px;gap:10px;align-items:center;padding:8px 0;border-top:1px solid color-mix(in srgb,var(--line) 65%,transparent)}.shortcut-row:first-child{border-top:0}.shortcut-btn{height:32px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--text);font-family:Consolas,"Microsoft YaHei",monospace;font-size:11px;cursor:pointer;padding:0 8px;text-align:center}.shortcut-btn.recording{outline:2px solid color-mix(in srgb,var(--blue) 35%,transparent);border-color:var(--blue);color:var(--blue)}.shortcut-btn.disabled{opacity:.5}.rangebox{display:flex;align-items:center;gap:8px}.rangebox output{width:42px;text-align:right;font-size:10px;color:var(--muted)}@media(max-width:680px){.colors{grid-template-columns:repeat(2,1fr)}.shortcut-row{grid-template-columns:1fr 44px}.shortcut-btn{grid-column:1/-1}.page{padding:10px}}
